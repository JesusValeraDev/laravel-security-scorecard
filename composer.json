{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "jesusvaleradev/laravel-security-scorecard",
    "type": "project",
    "description": "A passive security scorecard for Laravel apps, built as a modular monolith with DDD/hexagonal architecture.",
    "keywords": ["laravel", "security", "ddd", "modular-monolith", "hexagonal", "livewire"],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "laravel/framework": "^13.8",
        "laravel/tinker": "^3.0",
        "livewire/livewire": "^4.3"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.0",
        "laravel/pail": "^1.2.5",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^13.0",
        "rector/rector": "^2.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Modules\\": "modules/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "@composer install",
            "git config core.hooksPath .githooks",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --force",
            "npm install",
            "npm run build"
        ],
        "post-install-cmd": [
            "git config core.hooksPath .githooks || true"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,logs,vite --kill-others"
        ],
        "lint": "vendor/bin/pint --test",
        "fix": "vendor/bin/pint",
        "rector": "vendor/bin/rector --dry-run",
        "rector:fix": "vendor/bin/rector",
        "phpstan": "vendor/bin/phpstan analyse --memory-limit=512M",
        "test": [
            "@lint",
            "@phpstan",
            "@php artisan config:clear --ansi",
            "./vendor/bin/phpunit"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
